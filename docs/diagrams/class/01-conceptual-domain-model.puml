@startuml
!include ../common/style.puml

title HANBAY HOTEL - Conceptual Domain Model
left to right direction
hide methods
hide stereotypes

package "Identity & Access" {
  class User
  class Role
}

package "Room Inventory" {
  class RoomType
  class Room
}

package "Reservation" {
  class Booking
  class BookingRoom
  class BookingGuest
}

package "Payment" {
  class Payment
}

package "Pricing" {
  class PriceRate
  class AddOnService
  class BookingAddOn
}

package "AI Assistance" {
  class AIRequest
}

User "*" -- "*" Role : assigned roles
User "1" -- "0..*" Booking : places
RoomType "1" *-- "1..*" Room : contains
Booking "1" *-- "1..*" BookingRoom : reserves
Booking "1" *-- "1" BookingGuest : guest details
BookingRoom "*" --> "1" RoomType : requested type
BookingRoom "0..*" --> "0..1" Room : assigned at check-in
Booking "1" -- "0..*" Payment : payments
RoomType "1" -- "0..*" PriceRate : pricing rules
Booking "1" -- "0..*" BookingAddOn
AddOnService "1" -- "0..*" BookingAddOn
User "0..1" -- "0..*" AIRequest : submits

note bottom of Booking
  Aggregate root for reservation lifecycle.
  PENDING bookings hold inventory until expired.
end note

note bottom of BookingRoom
  A physical Room can remain unassigned
  until front desk check-in.
end note

@enduml
