' HANBAY HOTEL - Common PlantUML Style

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 12
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam actorStyle awesome

skinparam title {
    FontSize 20
    FontStyle bold
    FontColor #1F2937
}

skinparam actor {
    BorderColor #1F4E78
    BackgroundColor #EAF3F8
    FontColor #1F2937
}

skinparam rectangle {
    BorderColor #2C3E50
    BackgroundColor #FFFFFF
    FontColor #1F2937
}

skinparam package {
    BorderColor #6B7280
    BackgroundColor #F9FAFB
    FontColor #1F2937
}

skinparam usecase {
    BorderColor #1F4E78
    BackgroundColor #F4F8FB
    FontColor #1F2937
    ArrowColor #4B5563
}

skinparam note {
    BorderColor #9CA3AF
    BackgroundColor #FFFBEA
    FontColor #374151
}

skinparam ArrowColor #4B5563
skinparam ArrowThickness 1.2

' ===== Sequence Diagram Style =====
skinparam sequence {
    ArrowColor #475569
    LifeLineBorderColor #94A3B8
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #1F4E78
    ParticipantBackgroundColor #EAF3F8
    ParticipantFontColor #1F2937
    ActorBorderColor #1F4E78
    ActorBackgroundColor #EAF3F8
    ActorFontColor #1F2937
    DatabaseBorderColor #7C3AED
    DatabaseBackgroundColor #F5F3FF
    DatabaseFontColor #1F2937
    EntityBorderColor #0F766E
    EntityBackgroundColor #F0FDFA
    EntityFontColor #1F2937
    ControlBorderColor #B45309
    ControlBackgroundColor #FFF7ED
    ControlFontColor #1F2937
    BoundaryBorderColor #0369A1
    BoundaryBackgroundColor #F0F9FF
    BoundaryFontColor #1F2937
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F8FAFC
    GroupHeaderFontColor #1F2937
    DividerBackgroundColor #E2E8F0
    DividerBorderColor #94A3B8
    DividerFontColor #1F2937
    ReferenceBorderColor #64748B
    ReferenceBackgroundColor #F8FAFC
    ReferenceFontColor #1F2937
}

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 90
skinparam ParticipantPadding 18
skinparam BoxPadding 12
