COMPOSE_PROJECT_NAME=hotelbooking

# Docker application images and published ports
BACKEND_IMAGE=hanbay-hotel-backend:local
FRONTEND_IMAGE=hanbay-hotel-frontend:local
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Comma-separated frontend origins allowed to call the backend API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required: use a unique random value with at least 32 characters
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_ISSUER=hotel-booking-system
REFRESH_TOKEN_EXPIRATION_SECONDS=604800

POSTGRES_IMAGE=pgvector/pgvector:pg17
POSTGRES_CONTAINER_NAME=hotelbooking_db
POSTGRES_PORT=5432
POSTGRES_USER=hotelbooking_user
POSTGRES_PASSWORD=
POSTGRES_DB=hotelbooking_db

REDIS_IMAGE=redis:8-alpine
REDIS_CONTAINER_NAME=hotelbooking_redis
REDIS_HOST=localhost
REDIS_PORT=6379

PGADMIN_IMAGE=dpage/pgadmin4:latest
PGADMIN_CONTAINER_NAME=hotelbooking-pgadmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin

ADMIN_DEFAULT_ENABLED=true
ADMIN_DEFAULT_EMAIL=admin@gmail.com
ADMIN_DEFAULT_PHONE=0900000001
ADMIN_DEFAULT_FULL_NAME=Admin
ADMIN_DEFAULT_PASSWORD=

# Password reset email
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
PASSWORD_RESET_EXPIRATION_MINUTES=15
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
SUPPORT_EMAIL=support@hanbay-hotel.local
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_RESET_FORGOT_RATE_LIMIT=5
PASSWORD_RESET_VERIFY_RATE_LIMIT=20
PASSWORD_RESET_SUBMIT_RATE_LIMIT=10
PASSWORD_RESET_RETENTION_DAYS=7

# Unified AI chat and policy RAG
AI_CHAT_MODEL=openai
AI_EMBEDDING_MODEL=openai
AI_POLICY_RAG_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Booking cancellation policy
BOOKING_CHECK_IN_TIME=14:00
HOTEL_TIME_ZONE=Asia/Ho_Chi_Minh
BOOKING_FULL_REFUND_HOURS=48
BOOKING_PARTIAL_REFUND_HOURS=24
BOOKING_PARTIAL_REFUND_PERCENT=50
