@startuml
!include ../common/style.puml

title HANBAY HOTEL - Create Booking

autonumber

actor Guest
boundary "Web Application" as Web
control "Booking API" as API
control "Booking Service" as BookingService
control "Availability Service" as Availability
control "Pricing Service" as Pricing
database "Hotel Database" as DB

Guest -> Web: Submit booking information
Web -> API: POST /bookings
API -> BookingService: createBooking(command)

activate BookingService

group Transaction
    BookingService -> DB: Lock selected room type
    DB --> BookingService: Lock acquired

    BookingService -> Availability: checkAvailability(criteria)
    Availability -> DB: Count active overlapping bookings
    DB --> Availability: Occupied quantity
    Availability --> BookingService: Availability result

    alt Room unavailable
        BookingService -> BookingService: Roll back transaction
        BookingService --> API: Room not available
    else Room available
        BookingService -> Pricing: calculateBookingPrice(criteria, addOns)
        Pricing -> DB: Load applicable price rules
        DB --> Pricing: Price rules
        Pricing --> BookingService: Final price snapshot

        BookingService -> DB: Save PENDING booking\nexpiresAt = now + 15 minutes
        DB --> BookingService: Booking created

        BookingService --> API: Booking result
    end
end

deactivate BookingService

alt Booking created
    API --> Web: 201 Created
    Web --> Guest: Show booking code\nand payment deadline
else Booking rejected
    API --> Web: 409 Conflict
    Web --> Guest: Show room unavailable message
end

note over BookingService, DB
The lock, availability re-check and booking creation
must happen inside the same transaction.
end note

@enduml
