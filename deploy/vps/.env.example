COMPOSE_PROJECT_NAME=hanbay
BACKEND_IMAGE=hanbay-hotel-backend:amd64
FRONTEND_IMAGE=hanbay-hotel-frontend:amd64
# Replace with http://VPS_IP or https://your-domain (no trailing slash)
PUBLIC_URL=https://hotel.phuocanh.me
HTTP_PORT=8081
POSTGRES_IMAGE=pgvector/pgvector:pg17
POSTGRES_DB=hotelbooking
POSTGRES_USER=hotelbooking
POSTGRES_PASSWORD=
REDIS_IMAGE=redis:8-alpine
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_ISSUER=hotel-booking-system
REFRESH_TOKEN_EXPIRATION_SECONDS=604800
ADMIN_DEFAULT_ENABLED=true
ADMIN_DEFAULT_EMAIL=admin@hanbay.local
ADMIN_DEFAULT_PHONE=0900000001
ADMIN_DEFAULT_FULL_NAME=Hanbay Admin
ADMIN_DEFAULT_PASSWORD=
# Fill provider credentials to enable AI, email and payments
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_POLICY_RAG_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
SUPPORT_EMAIL=support@hanbay.local
SEPAY_BANK_CODE=Vietcombank
SEPAY_BANK_ACCOUNT_NUMBER=
SEPAY_BANK_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=

MINIO_ACCESS_KEY=hotel-images-app
MINIO_SECRET_KEY=
MINIO_BUCKET=hotel-images
