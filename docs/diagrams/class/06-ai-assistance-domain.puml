@startuml
!include ../common/style.puml

title HANBAY HOTEL - AI Assistance Domain
left to right direction
hide methods

class AIRequest <<aggregate root>> {
  +UUID id
  +AIFeature feature
  +String prompt
  +String response
  +String model
  +AIRequestStatus status
  +int promptTokens
  +int completionTokens
  +Duration latency
  +Instant createdAt
}

class AIRecommendation <<entity>> {
  +UUID id
  +UUID recommendedRoomTypeId
  +String reason
  +BigDecimal estimatedPrice
  +BigDecimal confidenceScore
}

class PolicyDocument <<entity>> {
  +UUID id
  +String code
  +String title
  +String content
  +int version
  +boolean active
}

class User <<external entity>>
class RoomType <<external entity>>

enum AIFeature {
  ROOM_RECOMMENDATION
  POLICY_ASSISTANT
  BOOKING_SUMMARY
  ADMIN_INSIGHT
}

enum AIRequestStatus {
  SUCCESS
  FAILED
  REJECTED
}

User "0..1" -- "0..*" AIRequest : submits
AIRequest "1" *-- "0..1" AIRecommendation
AIRecommendation "*" --> "1" RoomType
AIRequest "0..*" -- "0..*" PolicyDocument : context
AIRequest --> AIFeature
AIRequest --> AIRequestStatus

note bottom of AIRecommendation
  Advisory only. Availability, final price
  and booking creation remain backend decisions.
end note

@enduml
