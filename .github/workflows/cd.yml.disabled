name: Production CD

# PRs run CI only. Every push to main verifies the merged commit before deployment.
on:
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: production
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  backend-ci:
    if: github.ref == 'refs/heads/main'
    uses: ./.github/workflows/backend-ci.yml
  frontend-ci:
    if: github.ref == 'refs/heads/main'
    uses: ./.github/workflows/frontend-ci.yml
  deployment-ci:
    if: github.ref == 'refs/heads/main'
    uses: ./.github/workflows/deployment-ci.yml
  deploy:
    needs: [backend-ci, frontend-ci, deployment-ci]
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    timeout-minutes: 35
    environment:
      name: production
      url: https://hotel.phuocanh.me
    env:
      RELEASE_TAG: sha-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
    steps:
      - uses: actions/checkout@v6
      - uses: docker/setup-buildx-action@v3
      - name: Build backend
        uses: docker/build-push-action@v6
        with:
          context: .
          file: hotel-booking/Dockerfile
          platforms: linux/amd64
          load: true
          tags: hanbay-hotel-backend:${{ env.RELEASE_TAG }}
          cache-from: type=gha,scope=backend
          cache-to: type=gha,mode=max,scope=backend
      - name: Build frontend
        uses: docker/build-push-action@v6
        with:
          context: .
          file: client/Dockerfile
          platforms: linux/amd64
          load: true
          tags: hanbay-hotel-frontend:${{ env.RELEASE_TAG }}
          cache-from: type=gha,scope=frontend
          cache-to: type=gha,mode=max,scope=frontend
      - name: Configure SSH
        env:
          SSH_KEY: ${{ secrets.VPS_SSH_PRIVATE_KEY }}
          KNOWN_HOSTS: ${{ vars.VPS_KNOWN_HOSTS }}
        run: |
          test -n "$SSH_KEY" && test -n "$KNOWN_HOSTS"
          install -m 700 -d ~/.ssh
          printf '%s\n' "$SSH_KEY" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          printf '%s\n' "$KNOWN_HOSTS" > ~/.ssh/known_hosts
      - name: Transfer and deploy complete release
        run: |
          set -euo pipefail
          # A queued/manual rerun must not replace production with an older main.
          latest=$(git ls-remote origin refs/heads/main | cut -f1)
          test "$latest" = "$GITHUB_SHA" || { echo 'main has advanced; deploy its newer run instead.'; exit 1; }
          target=hotelapp@163.61.183.153
          release="/opt/hotelapp/releases/$GITHUB_SHA-$GITHUB_RUN_ID-$GITHUB_RUN_ATTEMPT"
          docker save "hanbay-hotel-backend:$RELEASE_TAG" "hanbay-hotel-frontend:$RELEASE_TAG" | gzip > /tmp/hotel-images.tar.gz
          ssh -o BatchMode=yes -o ConnectTimeout=15 "$target" "umask 077; mkdir -p '$release'"
          scp -o BatchMode=yes /tmp/hotel-images.tar.gz "$target:$release/images.tar.gz"
          scp -o BatchMode=yes deploy/vps/docker-compose.yml deploy/vps/nginx.conf deploy/vps/deploy.sh deploy/vps/migrate-images.py deploy/vps/verify-public.py deploy/vps/smoke-test.py deploy/vps/minio-console.conf deploy/vps/install-minio-console.sh "$target:$release/"
          ssh -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=30 -o ServerAliveCountMax=6 "$target" "docker load -i '$release/images.tar.gz' && rm -f '$release/images.tar.gz' && BACKEND_IMAGE='hanbay-hotel-backend:$RELEASE_TAG' FRONTEND_IMAGE='hanbay-hotel-frontend:$RELEASE_TAG' bash '$release/deploy.sh' '$release'"
      - name: Record deployed commit
        run: printf 'Deployed commit %s after CI and VPS public checks passed.\n' "$GITHUB_SHA" >> "$GITHUB_STEP_SUMMARY"
