### 9. Payment code đúng format nhưng không tồn tại - event được IGNORED
POST {{baseUrl}}/payments/sepay/webhook
Authorization: Apikey {{webhookApiKey}}
Content-Type: application/json

{
  "id": 987654337,
  "gateway": "{{gateway}}",
  "transactionDate": "2026-08-17 09:37:00",
  "accountNumber": "{{accountNumber}}",
  "content": "PAY-20260817093700-00000000000000000000000000000000",
  "transferType": "in",
  "transferAmount": 100000,
  "accumulated": 100000,
  "description": "Mã không tồn tại",
  "referenceCode": "DEMO-UNKNOWN-CODE-987654337"
}

