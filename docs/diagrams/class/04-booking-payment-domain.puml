@startuml
!include ../common/style.puml

title HANBAY HOTEL - Booking and Payment Domain
left to right direction
hide methods

class Booking <<aggregate root>> {
  +UUID id
  +String bookingCode
  +LocalDate checkInDate
  +LocalDate checkOutDate
  +int adults
  +int children
  +BookingStatus status
  +BigDecimal roomAmount
  +BigDecimal addOnAmount
  +BigDecimal totalAmount
  +Instant expiresAt
  +Instant createdAt
}

class BookingGuest <<value object>> {
  +String fullName
  +String email
  +String phone
  +String identityNumber
}

class BookingRoom <<entity>> {
  +UUID id
  +BigDecimal unitPrice
  +int quantity
}

class BookingAddOn <<entity>> {
  +UUID id
  +int quantity
  +BigDecimal unitPrice
  +BigDecimal totalPrice
}

class BookingStatusHistory <<entity>> {
  +UUID id
  +BookingStatus fromStatus
  +BookingStatus toStatus
  +String reason
  +Instant changedAt
}

class Payment <<aggregate root>> {
  +UUID id
  +BigDecimal amount
  +PaymentStatus status
  +String transactionRef
  +Instant paidAt
  +Instant createdAt
}

class PaymentWebhookEvent <<entity>> {
  +UUID id
  +String eventId
  +String payloadHash
  +Instant receivedAt
  +Instant processedAt
  +WebhookStatus status
}

class RoomType <<external entity>>
class Room <<external entity>>
class AddOnService <<external entity>>
class User <<external entity>>

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

User "1" -- "0..*" Booking : customer
Booking "1" *-- "1" BookingGuest
Booking "1" *-- "1..*" BookingRoom
Booking "1" *-- "0..*" BookingAddOn
Booking "1" *-- "1..*" BookingStatusHistory
Booking "1" *-- "0..*" Payment
BookingRoom "*" --> "1" RoomType
BookingRoom "*" --> "0..1" Room : assigned room
BookingAddOn "*" --> "1" AddOnService
Payment "1" *-- "0..*" PaymentWebhookEvent
Booking --> BookingStatus
Payment --> PaymentStatus
PaymentWebhookEvent --> WebhookStatus

note bottom of Booking
  Invariant:
  checkInDate < checkOutDate.
  PENDING bookings expire after 15 minutes.
  A booking reserves a RoomType; its physical Room
  remains unassigned until front-desk check-in.
end note

note bottom of PaymentWebhookEvent
  eventId or transactionRef must be unique
  to guarantee webhook idempotency.
end note

@enduml
