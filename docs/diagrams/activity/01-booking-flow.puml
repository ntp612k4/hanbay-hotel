@startuml
!include ../common/style.puml

title HANBAY HOTEL - Booking Flow Activity Diagram

|Guest|
start
:Enter check-in/check-out dates,
number of guests;
:Search available room types;

|System|
:Validate search criteria;
if (Criteria valid?) then (Yes)
  :Calculate availability by room type;
  :Calculate dynamic price for each night;
  :Return available room types;
else (No)
  :Return validation errors;
  stop
endif

|Guest|
:Select room type;
:View room details and policies;
:Enter guest information;
if (Select add-on services?) then (Yes)
  :Select add-on services;
endif
:Submit booking request;

|System|
:Validate guest and stay information;
:Begin database transaction;
:Lock selected room type inventory;
:Re-check availability inside transaction;
if (Room inventory available?) then (Yes)
  :Calculate final amount;
  :Create booking with status PENDING;
  :Set expiresAt = now + 15 minutes;
  :Reserve inventory by RoomType;
  :Create nightly price snapshots
  and add-on records;
  note right
    No physical Room is assigned here.
    The guest reserves a RoomType only.
    Reception assigns an AVAILABLE physical Room
    during check-in after the booking is CONFIRMED.
  end note
  :Commit transaction;
  :Return booking details and payment deadline;
else (No)
  :Rollback transaction;
  :Return ROOM_NOT_AVAILABLE conflict;
  stop
endif

|Guest|
if (Proceed to payment?) then (Yes)
  :Request payment;
  |System|
  :Create payment attempt;
  :Return payment information;
  |Guest|
  :Complete payment on gateway;
  note right
    Payment confirmation is handled
    asynchronously by webhook.
  end note
else (No)
  :Leave booking in PENDING state;
endif

stop
@enduml
