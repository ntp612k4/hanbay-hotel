@startuml
!include ../common/style.puml

title HANBAY HOTEL - Housekeeping Use Case Diagram
left to right direction

actor "Housekeeping Staff" as Housekeeping
actor Manager

rectangle "HANBAY HOTEL - HOUSEKEEPING MANAGEMENT" {
    usecase "Login" as UC_Login
    usecase "View Dirty Rooms" as UC_ViewDirtyRooms
    usecase "View Assigned Tasks" as UC_ViewTasks
    usecase "Start Cleaning Room" as UC_StartCleaning
    usecase "Update Task Status" as UC_UpdateStatus
    usecase "Complete Cleaning" as UC_CompleteCleaning
    usecase "Mark Room as Available" as UC_MarkAvailable
    usecase "Report Room Issue" as UC_ReportIssue
    usecase "Set Room to Maintenance" as UC_SetMaintenance
}

Housekeeping --> UC_Login
Housekeeping --> UC_ViewDirtyRooms
Housekeeping --> UC_ViewTasks
Housekeeping --> UC_StartCleaning
Housekeeping --> UC_UpdateStatus
Housekeeping --> UC_CompleteCleaning
Housekeeping --> UC_ReportIssue

Manager --> UC_SetMaintenance

UC_StartCleaning ..> UC_ViewTasks : <<include>>
UC_StartCleaning ..> UC_UpdateStatus : <<include>>
UC_CompleteCleaning ..> UC_UpdateStatus : <<include>>
UC_CompleteCleaning ..> UC_MarkAvailable : <<include>>
UC_ReportIssue ..> UC_StartCleaning : <<extend>>
UC_SetMaintenance ..> UC_ReportIssue : <<extend>>

note bottom of UC_CompleteCleaning
A DIRTY room becomes AVAILABLE
only after cleaning is completed.
end note

@enduml
