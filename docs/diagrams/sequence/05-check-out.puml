@startuml
!include ../common/style.puml

title HANBAY HOTEL - Guest Check-out

autonumber

actor Receptionist
boundary "Front Desk Application" as FrontDesk
control "Front Desk API" as API
control "Check-out Service" as CheckOutService
control "Housekeeping Service" as HousekeepingService
database "Hotel Database" as DB

Receptionist -> FrontDesk: Start check-out
FrontDesk -> API: Check out booking
API -> CheckOutService: checkOut(bookingId, charges)

activate CheckOutService

group Transaction
    CheckOutService -> DB: Lock checked-in booking\nand assigned room
    DB --> CheckOutService: Locked records

    CheckOutService -> CheckOutService: Validate CHECKED_IN status
    CheckOutService -> CheckOutService: Calculate outstanding balance

    alt Outstanding balance unpaid
        CheckOutService --> API: Payment required
    else Balance settled
        CheckOutService -> DB: Save final charges
        CheckOutService -> DB: Update booking to CHECKED_OUT
        CheckOutService -> DB: Update room to DIRTY

        CheckOutService -> HousekeepingService: createCleaningTask(roomId)
        HousekeepingService -> DB: Save PENDING housekeeping task
        DB --> HousekeepingService: Task created
        HousekeepingService --> CheckOutService: Task result

        CheckOutService --> API: Check-out successful
    end
end

deactivate CheckOutService

alt Successful
    API --> FrontDesk: 200 OK
    FrontDesk --> Receptionist: Show final invoice
else Failed
    API --> FrontDesk: 400 or 409
    FrontDesk --> Receptionist: Show failure reason
end

@enduml
