@startuml
!include ../common/style.puml

title HANBAY HOTEL - Overall Use Case Diagram
left to right direction

actor Guest
actor Receptionist
actor "Housekeeping Staff" as Housekeeping
actor Manager
actor "System Administrator" as SysAdmin
actor "Payment Gateway" as PaymentGateway
actor "AI Provider" as AIProvider
actor Scheduler

rectangle "HANBAY HOTEL SYSTEM" {
    package "Customer Portal" {
        usecase "Register Account" as UC_Register
        usecase "Login" as UC_Login
        usecase "Search Available Rooms" as UC_SearchRooms
        usecase "View Room Details" as UC_ViewRoom
        usecase "Create Booking" as UC_CreateBooking
        usecase "Select Add-on Services" as UC_AddOn
        usecase "Make Payment" as UC_Payment
        usecase "View Booking History" as UC_ViewHistory
        usecase "Cancel Booking" as UC_CancelBooking
        usecase "Get AI Room Recommendation" as UC_Recommend
        usecase "Ask Hotel Policy" as UC_Policy
    }

    package "Front Desk Management" {
        usecase "View Reception Dashboard" as UC_Dashboard
        usecase "View Today's Arrivals" as UC_Arrivals
        usecase "View Today's Departures" as UC_Departures
        usecase "Search Booking" as UC_SearchBooking
        usecase "Assign Physical Room" as UC_AssignRoom
        usecase "Check In Guest" as UC_CheckIn
        usecase "Check Out Guest" as UC_CheckOut
        usecase "Add Additional Charges" as UC_Charges
    }

    package "Housekeeping Management" {
        usecase "View Dirty Rooms" as UC_DirtyRooms
        usecase "View Assigned Tasks" as UC_HKTasks
        usecase "Start Cleaning" as UC_StartCleaning
        usecase "Complete Cleaning" as UC_CompleteCleaning
        usecase "Report Room Issue" as UC_ReportIssue
    }

    package "Hotel Management" {
        usecase "Manage Room Types" as UC_ManageRoomTypes
        usecase "Manage Physical Rooms" as UC_ManageRooms
        usecase "Manage Pricing Rules" as UC_ManagePricing
        usecase "View Operational Reports" as UC_Reports
    }

    package "System Administration" {
        usecase "Manage User Accounts" as UC_ManageUsers
        usecase "Manage Roles and Permissions" as UC_ManageRoles
        usecase "Manage System Configuration" as UC_Config
        usecase "View Audit Logs" as UC_AuditLogs
    }

    package "Automated Processes" {
        usecase "Expire Pending Bookings" as UC_ExpireBooking
        usecase "Process Payment Webhook" as UC_Webhook
    }
}

Guest --> UC_Register
Guest --> UC_Login
Guest --> UC_SearchRooms
Guest --> UC_ViewRoom
Guest --> UC_CreateBooking
Guest --> UC_Payment
Guest --> UC_ViewHistory
Guest --> UC_CancelBooking
Guest --> UC_Recommend
Guest --> UC_Policy

Receptionist --> UC_Login
Receptionist --> UC_Dashboard
Receptionist --> UC_SearchBooking
Receptionist --> UC_AssignRoom
Receptionist --> UC_CheckIn
Receptionist --> UC_CheckOut
Receptionist --> UC_Charges

Housekeeping --> UC_Login
Housekeeping --> UC_DirtyRooms
Housekeeping --> UC_HKTasks
Housekeeping --> UC_StartCleaning
Housekeeping --> UC_CompleteCleaning
Housekeeping --> UC_ReportIssue

Manager --> UC_Login
Manager --> UC_ManageRoomTypes
Manager --> UC_ManageRooms
Manager --> UC_ManagePricing
Manager --> UC_Reports

SysAdmin --> UC_Login
SysAdmin --> UC_ManageUsers
SysAdmin --> UC_ManageRoles
SysAdmin --> UC_Config
SysAdmin --> UC_AuditLogs

PaymentGateway --> UC_Payment
PaymentGateway --> UC_Webhook
AIProvider --> UC_Recommend
AIProvider --> UC_Policy
Scheduler --> UC_ExpireBooking

UC_Dashboard ..> UC_Arrivals : <<include>>
UC_Dashboard ..> UC_Departures : <<include>>
UC_CreateBooking ..> UC_SearchRooms : <<include>>
UC_AddOn ..> UC_CreateBooking : <<extend>>
UC_Payment ..> UC_CreateBooking : <<extend>>
UC_AssignRoom ..> UC_SearchBooking : <<include>>
UC_CheckIn ..> UC_AssignRoom : <<include>>
UC_CheckOut ..> UC_SearchBooking : <<include>>
UC_Charges ..> UC_CheckOut : <<extend>>
UC_StartCleaning ..> UC_HKTasks : <<include>>
UC_CompleteCleaning ..> UC_HKTasks : <<include>>
UC_ReportIssue ..> UC_StartCleaning : <<extend>>
UC_Webhook ..> UC_Payment : <<include>>

@enduml
