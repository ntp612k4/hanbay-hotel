@startuml
!include ../common/style.puml

title HANBAY HOTEL - Guest Use Case Diagram
left to right direction

actor Guest
actor "Payment Gateway" as PaymentGateway
actor "AI Provider" as AIProvider

rectangle "HANBAY HOTEL - CUSTOMER PORTAL" {
    usecase "Register Account" as UC_Register
    usecase "Login" as UC_Login
    usecase "Xem thông tin cá nhân" as UC_ViewProfile
    usecase "Cập nhật thông tin cá nhân" as UC_UpdateProfile
    usecase "Search Available Rooms" as UC_SearchRooms
    usecase "View Room Details" as UC_ViewRoom
    usecase "Create Booking" as UC_CreateBooking
    usecase "Select Add-on Services" as UC_AddOn
    usecase "Calculate Booking Price" as UC_CalculatePrice
    usecase "Make Payment" as UC_Payment
    usecase "Confirm Booking" as UC_ConfirmBooking
    usecase "View Booking History" as UC_ViewHistory
    usecase "View Booking Details" as UC_ViewDetails
    usecase "Cancel Booking" as UC_Cancel
    usecase "Check Cancellation Policy" as UC_CheckPolicy
    usecase "Get AI Room Recommendation" as UC_Recommend
    usecase "Ask Hotel Policy" as UC_PolicyAssistant
}

Guest --> UC_Register
Guest --> UC_Login
Guest --> UC_ViewProfile
Guest --> UC_UpdateProfile
Guest --> UC_SearchRooms
Guest --> UC_ViewRoom
Guest --> UC_CreateBooking
Guest --> UC_Payment
Guest --> UC_ViewHistory
Guest --> UC_ViewDetails
Guest --> UC_Cancel
Guest --> UC_Recommend
Guest --> UC_PolicyAssistant

PaymentGateway --> UC_Payment
PaymentGateway --> UC_ConfirmBooking
AIProvider --> UC_Recommend
AIProvider --> UC_PolicyAssistant

UC_CreateBooking ..> UC_SearchRooms : <<include>>
UC_UpdateProfile ..> UC_ViewProfile : <<include>>
UC_CreateBooking ..> UC_CalculatePrice : <<include>>
UC_AddOn ..> UC_CreateBooking : <<extend>>
UC_Payment ..> UC_CreateBooking : <<extend>>
UC_ConfirmBooking ..> UC_Payment : <<include>>
UC_ViewDetails ..> UC_ViewHistory : <<extend>>
UC_Cancel ..> UC_CheckPolicy : <<include>>
UC_Recommend ..> UC_SearchRooms : <<extend>>

note bottom of UC_CreateBooking
Booking is created with PENDING status
and expires after 15 minutes if unpaid.
end note

@enduml
